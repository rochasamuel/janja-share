# Copy to .env and adjust. Never commit a filled-in .env.

# --- Signaling server ---
SIGNALING_PORT=8787
SIGNALING_HOST=0.0.0.0

# --- Client-facing endpoints ---
# Development (same machine or LAN):
SIGNALING_URL=ws://localhost:8787
# Production: SIGNALING_URL=wss://signal.example.com

# --- ICE ---
STUN_URL=stun:stun.l.google.com:19302

# TURN is only used when direct P2P fails. Leave blank for LAN-only testing.
TURN_URL=
TURN_TLS_URL=
TURN_REALM=janja.local
# Must match `static-auth-secret` in infra/coturn/turnserver.conf. Server-side only.
TURN_SECRET=
TURN_TTL_SECONDS=3600

# --- Channel policy ---
# People in one channel.
MAX_MEMBERS=8
# Viewers of one publisher. This is the sharer's upload ceiling, not the
# channel size: each viewer costs another copy of the stream going out.
MAX_VIEWERS=6
