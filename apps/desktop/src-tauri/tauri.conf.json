{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenShare",
  "version": "0.1.0",
  "identifier": "com.automatizai.janjashare",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenShare",
        "width": 420,
        "height": 560,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss: http: https:"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-idle.png",
      "iconAsTemplate": false,
      "tooltip": "ScreenShare — idle"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
